# =============================================================================
# LedgerLoop — environment variables
# =============================================================================
# Copy to .env.local for local dev. Never commit a filled-in copy.
#
# The app boots in "demo mode" if DATABASE_URL is unset — useful for getting
# `pnpm dev` running on a fresh clone without any external services set up.
# Sign-in and the persist step of CSV import are no-ops in demo mode.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# Public app URL. No trailing slash.
# Local: http://localhost:3000  | Staging: https://staging.ledgerloop.app  | Prod: https://ledgerloop.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (Auth + Postgres + Storage)
# -----------------------------------------------------------------------------

# REQUIRED for real auth + persistence. https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string. Use Supabase's "Connection Pooler" URL (transaction mode, port 6543)
# for the app and the "Direct Connection" URL (port 5432) for `drizzle-kit migrate`.
# Format: postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional. Direct (non-pooled) URL used by `drizzle-kit migrate`. Required for migrations only.
DIRECT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Stripe — wired in step 5 of BUILD-PLAN.md (Launch, days 27-30)
# -----------------------------------------------------------------------------

# Use sk_test_… locally, sk_live_… in production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Different value per environment.
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` to develop locally.
STRIPE_WEBHOOK_SECRET=

# Single price for the MVP — £9/mo with 14-day trial.
STRIPE_PRICE_DEFAULT=

# -----------------------------------------------------------------------------
# Anthropic (step 4 — AI listing suggestions)
# -----------------------------------------------------------------------------

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Inngest (step 3 — eBay sync)
# -----------------------------------------------------------------------------

# https://www.inngest.com/docs/sdk/serve#configuration
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# -----------------------------------------------------------------------------
# eBay (step 3 — eBay OAuth)
# -----------------------------------------------------------------------------

# sandbox | production. Switching invalidates all stored tokens.
EBAY_ENV=sandbox

# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Must exactly match the redirect URI registered in eBay's developer portal.
EBAY_REDIRECT_URI=http://localhost:3000/api/auth/ebay/callback

# 32-byte base64 key used to AES-256-GCM encrypt eBay refresh tokens at rest.
# Generate: openssl rand -base64 32
# Rotation procedure: see DECISIONS.md § 3.3 (note: that doc is stale on stack but
# the rotation logic still applies — set ENCRYPTION_KEY_OLD, run tokens:rotate-key).
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email (Resend) — step 5
# -----------------------------------------------------------------------------

RESEND_API_KEY=
EMAIL_FROM=LedgerLoop <hello@ledgerloop.app>

# -----------------------------------------------------------------------------
# Observability — step 5
# -----------------------------------------------------------------------------

# Sentry — captures errors from web app
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
